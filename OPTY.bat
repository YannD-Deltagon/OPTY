echo(     %cVal%5.%cR%  Repair Windows  %cInfo%guided DISM, SFC, disk check%cR%
echo(     %cVal%6.%cR%  Maintenance     %cInfo%driver store, clean OPTY's own files%cR%
echo(     %cVal%0.%cR%  Exit
echo(
