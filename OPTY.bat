call :L "%cStep%" "CHKDSK - online integrity scan (SSD-safe, no reboot)..."
chkdsk %SystemDrive% /scan
>>%logs% echo %date% %time% : CHKDSK /scan exit=%errorlevel%
echo %date% %time% : Executed chkdsk /scan                         >> %logs%
