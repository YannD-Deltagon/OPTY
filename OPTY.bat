echo.                                                  
set "choice="
set /p choice= Enter action:
echo %date% %time% : Opti-mopti "%choice%"                            >> %logs%
if /i "%choice%"=="1" (set "autoclean=0" & set "autoshutdownreboot=5" & call :logvars & goto mdisenable)
