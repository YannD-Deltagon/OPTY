::X|EN|cl.gpu.shadercache.026|                    %USERPROFILE%\AppData\LocalLow\AMD\DxCache;
::X|EN|cl.gpu.shadercache.027|                    %LOCALAPPDATA%\NVIDIA\GLCache, DXCache, ComputeCache,
