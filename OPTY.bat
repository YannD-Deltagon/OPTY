::X|EN|cl.gpu.shadercache.029|                    %LOCALAPPDATA%\Intel\ShaderCache;
::X|EN|cl.gpu.shadercache.030|                    %LOCALAPPDATA%\D3DSCache;
::X|EN|cl.gpu.shadercache.031|                    %LOCALAPPDATA%\Microsoft\DirectX Shader Cache. There
